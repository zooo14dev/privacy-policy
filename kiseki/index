<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>プライバシーポリシー - 季跡</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Hiragino Sans", sans-serif;
      background: #0C0B12;
      color: #EEECF6;
      line-height: 1.8;
      padding: 24px 20px 60px;
      max-width: 720px;
      margin: 0 auto;
    }
    h1 { font-size: 22px; font-weight: 700; margin-bottom: 6px; color: #fff; }
    .meta { font-size: 13px; color: #9D8AFF; margin-bottom: 36px; }
    h2 {
      font-size: 16px; font-weight: 600;
      color: #9D8AFF;
      margin: 32px 0 10px;
      padding-bottom: 6px;
      border-bottom: 1px solid rgba(157,138,255,0.2);
    }
    p { font-size: 15px; color: #EEECF6; margin-bottom: 10px; }
    ul { padding-left: 20px; margin-bottom: 10px; }
    li { font-size: 15px; color: #EEECF6; margin-bottom: 6px; }
    a { color: #9D8AFF; text-decoration: none; }
    a:hover { text-decoration: underline; }
    .card {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 12px;
      padding: 16px 18px;
      margin-top: 10px;
    }
    .badge {
      display: inline-block;
      background: rgba(157,138,255,0.15);
      color: #9D8AFF;
      font-size: 11px;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: 4px;
      margin-right: 6px;
    }
